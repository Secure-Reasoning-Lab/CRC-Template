# Recommended: the OpenAI-compatible upstream used by the OSS-CRS internal
# LiteLLM sidecar. It must implement /v1/responses with streaming function
# calls and function_call_output for the OpenAI-backed Claude aliases. Keep
# real values only in the ignored root .env file or in your shell.
CRC_LITELLM_UPSTREAM_BASE_URL=https://api.example.com/v1
CRC_LITELLM_UPSTREAM_API_KEY=

# Optional OAuth fallback. Do not set this for a LiteLLM run: the wrappers
# deliberately clear it so Claude Code cannot bypass the proxy.
CLAUDE_CODE_OAUTH_TOKEN=

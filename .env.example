# Local development credentials for the OpenAI-compatible LLM upstream.
# In Claude runs, the LiteLLM sidecar started by OSS-CRS forwards requests to
# this endpoint. It must implement /v1/responses with streaming function calls
# and function_call_output. Keep real values only in the ignored root .env file
# or in your shell.
LITELLM_UPSTREAM_BASE_URL=https://api.example.com/v1
LITELLM_UPSTREAM_API_KEY=

# Optional OAuth fallback. Do not set this for a LiteLLM run: the wrappers
# deliberately clear it so Claude Code cannot bypass the proxy.
CLAUDE_CODE_OAUTH_TOKEN=
